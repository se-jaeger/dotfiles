{
  "title": "Base Layer",
  "rules": [
    {
      "description": "Globe → ctrl+shift+option (held together)",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "caps_lock", "modifiers": { "optional": ["any"]}},
          "to": [{ "key_code": "left_control", "modifiers": ["left_shift", "left_option"]}]
        }
      ]
    },
    {
      "description": "J+K (simultaneous) → escape",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "simultaneous": [{ "key_code": "j" }, { "key_code": "k" }],
            "simultaneous_options": { "key_down_order": "insensitive", "key_up_order": "insensitive"}
          },
          "to": [{ "key_code": "escape" }]
        }
      ]
    },
    {
      "description": "D+F (simultaneous) → option+delete",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "simultaneous": [{ "key_code": "d" }, { "key_code": "f" }],
            "simultaneous_options": { "key_down_order": "insensitive", "key_up_order": "insensitive"}
          },
          "to": [{ "key_code": "delete_or_backspace", "modifiers": ["left_option"]}]
        }
      ]
    },
    {
      "description": "F+J (simultaneous) → CTRL-G (zellij leader key)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "simultaneous": [{ "key_code": "f" }, { "key_code": "j" }],
            "simultaneous_options": { "key_down_order": "insensitive", "key_up_order": "insensitive"}
          },
          "to": [{ "key_code": "g", "modifiers": ["left_control"]}]
        }
      ]
    },
    {
      "description": "Left Home Row Mods",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "f", "modifiers": { "optional": ["any"]}},
          "to_if_alone": [{ "key_code": "f", "halt": true}],
          "to_if_held_down": [{ "key_code": "left_control", "halt": true }],
          "to_delayed_action": { "to_if_canceled": [{ "key_code": "f" }]}
        },
        {
          "type": "basic",
          "from": { "key_code": "d", "modifiers": { "optional": ["any"]}},
          "to_if_alone": [{ "key_code": "d", "halt": true}],
          "to_if_held_down": [{ "key_code": "left_command", "halt": true }],
          "to_delayed_action": { "to_if_canceled": [{ "key_code": "d" }]}
        },
        {
          "type": "basic",
          "from": { "key_code": "s", "modifiers": { "optional": ["any"]}},
          "to_if_alone": [{ "key_code": "s", "halt": true}],
          "to_if_held_down": [{ "key_code": "left_option", "halt": true }],
          "to_delayed_action": { "to_if_canceled": [{ "key_code": "s" }]}
        }
      ]
    },
    {
      "description": "Right Home Row Mods",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "j", "modifiers": { "optional": ["any"]}},
          "to_if_alone": [{ "key_code": "j", "halt": true}],
          "to_if_held_down": [{ "key_code": "right_control", "halt": true }],
          "to_delayed_action": { "to_if_canceled": [{ "key_code": "j" }]}
        },
        {
          "type": "basic",
          "from": { "key_code": "k", "modifiers": { "optional": ["any"]}},
          "to_if_alone": [{ "key_code": "k", "halt": true}],
          "to_if_held_down": [{ "key_code": "right_command", "halt": true }],
          "to_delayed_action": { "to_if_canceled": [{ "key_code": "k" }]}
        },
        {
          "type": "basic",
          "from": { "key_code": "l", "modifiers": { "optional": ["any"]}},
          "to_if_alone": [{ "key_code": "l", "halt": true}],
          "to_if_held_down": [{ "key_code": "right_option", "halt": true }],
          "to_delayed_action": { "to_if_canceled": [{ "key_code": "l" }]}
        }
      ]
    }
  ]
}
